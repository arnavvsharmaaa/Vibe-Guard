HOST=127.0.0.1
PORT=8000
# Replaces the built-in localhost origins when set (production: the static site URL only)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Host allowlist; empty = no Host check (local development). Production: the API host name
ALLOWED_HOSTS=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=30
AI_MAX_FINDINGS=25
DATABASE_URL=
# Empty = backend/uploads
UPLOAD_DIR=
# 1 = serve /docs, /redoc and /openapi.json (off by default)
ENABLE_DOCS=
# Public-demo abuse limits
MAX_ACTIVE_SCANS=1
SCAN_RATE_LIMIT=5
SCAN_RATE_WINDOW_SECONDS=600
# Reverse proxies that append to X-Forwarded-For (0 = use the socket address; Render: 1)
TRUSTED_PROXY_HOPS=0
